# 图文视频工坊 · 配置模板
#
# 用法：别直接改这个文件。跑 `tuwen setup`，在浏览器里填，会写到你自己的目录：
#   Windows : C:\Users\<你>\.dsh\tuwen\.env
#   macOS   : ~/.dsh/tuwen/.env
# 那个文件优先级高于本目录的 .env，而且不会被提交进仓库。
#
# 优先级：进程环境变量 > ~/.dsh/tuwen/.env > 本目录 .env
# 也就是说，把这份文件复制成 .env 只适合临时试验，长期配置请用 tuwen setup。

# ── 图像（火山方舟 Seedream）────────────────────────────────────
# 不填也能出片：会用占位图。但占位图的片子不算成品，result.degraded 会是 true。
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_IMAGE_MODEL=doubao-seedream-4-5-251128
# 只对 9:16 生效；16:9 会按比例自动换成 2560x1440
ARK_IMAGE_SIZE=1440x2560

# ── 配音（火山语音 Seed Audio，可选）──────────────────────────────
# 留空就用免费的 edge 配音（纯 Node 实现，不需要 Python）。
# volc 会「演」，适合故事和对白，但慢 5 倍、时长会变长 30~50%、结果不确定。
VOLC_TTS_APP_ID=
VOLC_TTS_ACCESS_TOKEN=
VOLC_TTS_SECRET_KEY=
VOLC_TTS_MODEL=seed-audio-1.0

# ── 高级 ───────────────────────────────────────────────────
# 留空就用随包安装的 ffmpeg-static / ffprobe-static
FFMPEG_PATH=
FFPROBE_PATH=
